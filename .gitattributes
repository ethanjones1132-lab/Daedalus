# The index is always LF. Working trees may differ; the repository does not.
# Without this a Windows checkout reports hundreds of modified files and hides
# the real diff inside line-ending churn.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never rewrite.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.icns  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.db    binary
*.sqlite binary
*.wasm  binary
*.gguf  binary
*.zip   binary
